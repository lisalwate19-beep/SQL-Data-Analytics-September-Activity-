CREATE CATALOG IF NOT EXISTS smart;

-- Step 2: Create a Schema
CREATE SCHEMA IF NOT EXISTS smart.intelligent;

-- Step 3: Create a Table
CREATE TABLE IF NOT EXISTS smart.intelligent.employees (
    ID_ INT,
    First_name STRING,
    Last_name STRING,
    Department STRING,
    Salary INT,
    Hire_date DATE,
    City STRING
);

