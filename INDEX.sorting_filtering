--Step 1: Create a Database/Catalog
CREATE CATALOG IF NOT EXISTS bright;

--Step 2: Creat a Schema 
CREATE SCHEMA IF NOT EXISTS bright.high;

--Step 3: Remove the old table (if it exists)
DROP TABLE IF EXISTS bright.high.top;

--Step 4: Create a Table 
CREATE TABLE IF NOT EXISTS bright.high.top (
i_D INT,
first_name STRING,
last_name STRING,
department STRING,
salary INT,
hire_date DATE,
city STRING
);

